    <!-- One-line description of each counting system, shown in Help and the system picker -->
    <string name="system_explanation_hi_lo">Most common beginner system: balanced +1/-1 tags; the bet ramp and indices are calibrated for it.</string>
    <string name="system_explanation_ko">Unbalanced running-count system using deck-specific initial running counts, key counts, and a pivot.</string>
    <string name="system_explanation_reko">Refined KO variant with deck-specific initial running counts and key-count references.</string>
    <string name="system_explanation_hi_opt_ii">Higher-power level-2 system using Hi-Lo indices scaled to its true count; strongest with an Ace side count.</string>
    <string name="system_explanation_omega_ii">Advanced level-2 balanced count using Hi-Lo indices scaled to its true count; often paired with Ace side count.</string>
    <string name="system_explanation_zen_count">Balanced level-2 count with heavier 4-6 tags; uses Hi-Lo indices scaled to its true count.</string>
    <string name="system_explanation_wong_halves">High-precision balanced system with half-point tags; uses Hi-Lo indices scaled to its true count.</string>
    <string name="system_explanation_other">Card-counting system with custom tag values for betting and deviation decisions.</string>

