<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prevent cleartext traffic (HTTP) in all builds. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system CAs (no user-installed certs in release). -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug override: also trust user certs for Charles/Fiddler during dev. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
